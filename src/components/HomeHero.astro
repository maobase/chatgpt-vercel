---
const title = "更轻更快的 ChatGPT Web UI"
const subtitle = "开箱即用、支持流式对话、提示词搜索、PWA 与深浅色主题。"
---

<section class="px-2em py-6em md:py-8em text-center" aria-labelledby="hero-title">
  <h1 id="hero-title" class="text-4xl md:text-5xl font-extrabold leading-tight">
    <span class="text-slate-8 dark:text-slate">ChatGPT</span>
    <span class="ml-2 text-transparent bg-clip-text bg-gradient-to-r dark:from-yellow-300 from-yellow-600 dark:to-red-700 to-red-700">Vercel</span>
  </h1>
  <p class="max-w-3xl mx-auto mt-4 text-slate-6 dark:text-slate-4 text-lg">
    {subtitle}
  </p>
  <div class="mt-8 flex justify-center gap-4">
    <a href="/chat" class="px-5 py-3 rounded-md bg-slate-9 text-white dark:bg-slate-7 dark:text-slate-1 hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-6" aria-label="开始使用 Chat">
      开始使用
    </a>
    <a href="https://github.com/ourongxing/chatgpt-vercel" target="_blank" rel="noopener" class="px-5 py-3 rounded-md border border-slate-6 text-slate-7 dark:text-slate dark:border-slate-5 hover:bg-slate-2 dark:hover:bg-slate-8 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-6" aria-label="查看 GitHub">
      GitHub
    </a>
  </div>
</section>
